{
  "manifest_version": 3,
  "name": "PRIDE KEEPER Forum Assistant",
  "version": "5.0.0",
  "description": "Универсальная панель состава, ответов, истории и управления темами форума Pride Keeper.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://forum.pridekeeper.tech/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PRIDE KEEPER Forum Assistant",
    "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png" }
  },
  "content_scripts": [{
    "matches": ["https://forum.pridekeeper.tech/*"],
    "css": ["src/panel.css"],
    "js": [
      "src/bootstrap.js",
      "src/context.js",
      "src/action-registry.js",
      "src/store.js",
      "src/history.js",
      "src/complaints.js",
      "src/preferences.js",
      "src/actions.js",
      "src/replies.js",
      "src/productivity.js",
      "src/inline-toolbar.js",
      "src/staff-gate.js",
      "src/staff.js",
      "src/panel.js",
      "src/runtime.js"
    ],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["assets/pridekeeper-logo.png", "assets/pridekeeper-paw.png", "assets/pridekeeper-wordmark.png"],
    "matches": ["https://forum.pridekeeper.tech/*"]
  }],
  "icons": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
}
