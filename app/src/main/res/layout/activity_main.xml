layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="⏸ Зупинити" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/battery" android:text="🔋 Налаштування батареї Samsung" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Важливо: у Viber увімкни автоматичне завантаження/збереження отриманих фото." android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="Очікує налаштування" android:textStyle="bold" android:paddingTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout></ScrollView>