{
  "manifest_version": 3,
  "name": "Arizona RP — цены Chandler",
  "description": "Цены Chandler, BTC, темы LogsParser и UID→ник через Shinoa. Версия для Chrome/Chromium.",
  "version": "1.4.3",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://wiki.arz-mcr.ru/*",
    "https://api.exchange.coinbase.com/*",
    "https://api.coingecko.com/*",
    "https://raw.githubusercontent.com/*",
    "https://logs.shinoa.tech/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arizonarp.logsparser.info/*"
      ],
      "js": [
        "ui.js",
        "content.js"
      ],
      "css": [
        "ui.css",
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kalus-price-hub.imvana122008.chatgpt.site/*"
      ],
      "js": [
        "site-access.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
